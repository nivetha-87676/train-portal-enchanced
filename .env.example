# ── Server Configuration ──
PORT=5000
NODE_ENV=development

# ── Client / CORS Configuration ──
CLIENT_ORIGIN=http://localhost:8000,http://localhost:8080,http://127.0.0.1:8000,http://127.0.0.1:8080

# ── JWT Secret (for authentication) ──
